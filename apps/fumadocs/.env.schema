# @defaultRequired=false
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Ask AI (OpenRouter). Optional: without a key the chat is hidden.
# @type=string
OPENROUTER_API_KEY=

# Model for Ask AI, as named on openrouter.ai/models.
# @public @type=string
OPENROUTER_MODEL=

# The Ecolens app, for "open this screen" links. Defaults to the demo.
# @public @type=url
NEXT_PUBLIC_APP_URL=
