# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
CLERK_SECRET_KEY=

# @public @type=string(minLength=1)
CLERK_PUBLISHABLE_KEY=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Cloudflare Browser Rendering (REST API) for report PDFs. Optional: without
# them reports are generated and can be printed to PDF from the browser.
# @public @required=false
CLOUDFLARE_ACCOUNT_ID=

# @required=false
BROWSER_RENDERING_TOKEN=

# NASA FIRMS MAP_KEY (free: https://firms.modaps.eosdis.nasa.gov/api/map_key/).
# Optional: without it live thermal ingestion is off.
# @required=false
FIRMS_MAP_KEY=
